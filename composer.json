{
    "name": "contenir/contenir-audience",
    "description": "Keeps people from a CMS in step with a mailing list or CRM: consent, field mapping, an outbox with retries, suppression and sync state. Framework free: PSR-18, PSR-3 and PSR-20, stored with php-db on MySQL or SQLite.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "newsletter",
        "mailing-list",
        "subscribers",
        "sync",
        "consent"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://github.com/contenir/contenir-audience/issues",
        "source": "https://github.com/contenir/contenir-audience"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "peptolab/phpdb-migration": "^0.2",
        "php-db/phpdb": "^0.6.0",
        "psr/clock": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "php-db/phpdb-mysql": "0.5.x-dev",
        "php-db/phpdb-sqlite": "0.3.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Audience\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Audience\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": [
            "phpunit --colors=always --testsuite integration",
            "@putenv CONTENIR_TEST_DB_PLATFORM=mysql",
            "phpunit --colors=always --testsuite integration"
        ],
        "test-coverage": "@php -d pcov.directory=. -d pcov.exclude=#/vendor/# vendor/bin/phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
